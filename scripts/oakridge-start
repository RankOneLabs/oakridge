#!/usr/bin/env bash
set -euo pipefail

if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 3))); then
  echo "oakridge: Bash 4.3 or newer is required (found $BASH_VERSION)" >&2
  exit 1
fi

OAKRIDGE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DBOS_ROOT="$OAKRIDGE_ROOT/oakridge-dbos"
DEFAULT_CORE_WASM="$OAKRIDGE_ROOT/workflow-core/target/wasm32-unknown-unknown/debug/workflow_evaluator.wasm"
CORE_WASM="${OAKRIDGE_CORE_WASM:-$DEFAULT_CORE_WASM}"
# Rebuild the default module on start so the engine version matches its source.
if [ -z "${OAKRIDGE_CORE_WASM:-}" ]; then
  if command -v cargo >/dev/null 2>&1; then
    echo "oakridge: building workflow WASM"
    cargo build --locked --target wasm32-unknown-unknown --manifest-path "$OAKRIDGE_ROOT/workflow-core/Cargo.toml" -p workflow-evaluator
  else
    # Never start the default module unverified: it may predate workflow-core/.
    CORE_TOOLCHAIN="$(sed -n 's/^channel = "\(.*\)"$/\1/p' "$OAKRIDGE_ROOT/workflow-core/rust-toolchain.toml")"
    echo "oakridge: Rust toolchain (cargo) is missing; install the pinned toolchain with: rustup toolchain install $CORE_TOOLCHAIN" >&2
    echo "oakridge: then build workflow WASM with: cargo build --locked --target wasm32-unknown-unknown --manifest-path workflow-core/Cargo.toml -p workflow-evaluator" >&2
    echo "oakridge: or set OAKRIDGE_CORE_WASM to a module built from this tree" >&2
    exit 1
  fi
fi
if [ ! -f "$CORE_WASM" ]; then
  echo "oakridge: workflow WASM is missing at $CORE_WASM" >&2
  exit 1
fi
# .mcp.json is the one place the gated-review endpoint is configured: DBOS
# observes pull requests through it and kbbl hands it to every agent session.
MCP_CONFIG="$OAKRIDGE_ROOT/.mcp.json"
read_gated_review_url() {
  bun -e '
    const path = process.argv[1];
    const file = Bun.file(path);
    if (!(await file.exists())) process.exit(0);
    const server = (await file.json()).mcpServers?.["gated-review"];
    if (server === undefined) process.exit(0);
    if (server?.type !== "http" || typeof server.url !== "string" || server.url.trim() === "") {
      console.error(`${path}: gated-review must be an http server with a url`);
      process.exit(1);
    }
    console.log(server.url.trim());' "$MCP_CONFIG"
}
if ! GATED_REVIEW_URL="$(read_gated_review_url)"; then
  echo "oakridge: cannot read the gated-review server from $MCP_CONFIG" >&2
  exit 1
fi
if [ -z "$GATED_REVIEW_URL" ]; then
  echo "oakridge: $MCP_CONFIG names no gated-review server; pull_request.observe will fail with discovery_unsupported" >&2
fi
# The default install keeps its publication key and agent workdir here;
# oakridge-shadow passes its own of each.
STATE_DIR="$HOME/.local/state/oakridge"
if [ -z "${OAKRIDGE_PUBLICATION_KEY:-}" ]; then
  # One key for the install's lifetime: rotating it breaks every resumed agent session.
  KEY_FILE="$STATE_DIR/publication.key"
  if [ ! -s "$KEY_FILE" ]; then
    mkdir -p "$STATE_DIR"
    (umask 077 && openssl rand -hex 32 > "$KEY_FILE")
  fi
  OAKRIDGE_PUBLICATION_KEY="$(cat "$KEY_FILE")"
fi
AGENT_WORKDIR="${OAKRIDGE_AGENT_WORKDIR:-$STATE_DIR/agent-workdir}"
DBOS_HOST="${OAKRIDGE_DBOS_HOST:-127.0.0.1}"
DBOS_PORT="${OAKRIDGE_DBOS_PORT:-8790}"
DBOS_URL_HOST="$DBOS_HOST"
if [[ "$DBOS_URL_HOST" == *:* ]] && [[ "$DBOS_URL_HOST" != \[*\] ]]; then
  DBOS_URL_HOST="[$DBOS_URL_HOST]"
fi
DBOS_URL="http://${DBOS_URL_HOST}:${DBOS_PORT}"
POSTGRES_CONTAINER="${OAKRIDGE_POSTGRES_CONTAINER:-oakridge-postgres}"
POSTGRES_PORT="${OAKRIDGE_POSTGRES_PORT:-54329}"
# The data volume follows the container, so a second container never opens
# another one's data directory. The default container keeps its historical volume.
POSTGRES_VOLUME="${OAKRIDGE_POSTGRES_VOLUME:-${POSTGRES_CONTAINER}-data}"
POSTGRES_IMAGE="${OAKRIDGE_POSTGRES_IMAGE:-postgres:16}"

KBBL_DISPLAY_HOST="127.0.0.1"
KBBL_DISPLAY_PORT="${KBBL_PORT:-8788}"
KBBL_INTERNAL_PORT="$KBBL_DISPLAY_PORT"
next_is_host=0
next_is_port=0
for arg in "$@"; do
  if [ "$next_is_host" -eq 1 ]; then
    next_is_host=0
    if [[ -n "$arg" && "$arg" != -* ]]; then KBBL_DISPLAY_HOST="$arg"; continue; fi
  elif [ "$next_is_port" -eq 1 ]; then
    next_is_port=0
    if [[ -n "$arg" && "$arg" != -* ]]; then KBBL_DISPLAY_PORT="$arg"; KBBL_INTERNAL_PORT="$arg"; continue; fi
  fi
  if [ "$arg" = "--host" ]; then next_is_host=1
  elif [[ "$arg" == --host=* ]]; then
    value="${arg#--host=}"
    if [ -z "$value" ]; then echo "oakridge: --host requires a non-empty value" >&2; exit 1; fi
    KBBL_DISPLAY_HOST="$value"
  elif [ "$arg" = "--port" ]; then next_is_port=1
  elif [[ "$arg" == --port=* ]]; then
    value="${arg#--port=}"
    if [ -z "$value" ]; then echo "oakridge: --port requires a non-empty value" >&2; exit 1; fi
    KBBL_DISPLAY_PORT="$value"
    KBBL_INTERNAL_PORT="$value"
  fi
done

KBBL_BIND_HOST="$KBBL_DISPLAY_HOST"
if [ "$KBBL_DISPLAY_HOST" = "0.0.0.0" ]; then
  KBBL_DISPLAY_HOST="<machine-ip-or-tailnet-name>"
elif [ "$KBBL_DISPLAY_HOST" = "::" ]; then
  KBBL_DISPLAY_HOST="<machine-ipv6-or-tailnet-name>"
elif [[ "$KBBL_DISPLAY_HOST" == *:* ]] && [[ "$KBBL_DISPLAY_HOST" != \[*\] ]]; then
  KBBL_DISPLAY_HOST="[$KBBL_DISPLAY_HOST]"
fi
KBBL_URL="http://127.0.0.1:${KBBL_INTERNAL_PORT}"

# Browser writes are refused from any origin not listed. Unless the operator
# lists them, allow the addresses this bind is reached at: loopback always, and
# for an all-interfaces bind this machine's hostname, addresses and tailnet name.
default_allowed_origins() {
  local hosts=(127.0.0.1 localhost) addresses=() tailnet_name host origins=()
  case "$KBBL_BIND_HOST" in
    127.0.0.1|localhost) ;;
    0.0.0.0|::)
      hosts+=("$(hostname)")
      read -r -a addresses <<< "$(hostname -I 2>/dev/null || true)"
      if [ "${#addresses[@]}" -gt 0 ]; then hosts+=("${addresses[@]}"); fi
      if command -v tailscale >/dev/null 2>&1; then
        tailnet_name="$(tailscale status --self --json 2>/dev/null \
          | bun -e 'const status = await Bun.stdin.json(); console.log((status.Self?.DNSName ?? "").replace(/\.$/, ""))' 2>/dev/null || true)"
        if [ -n "$tailnet_name" ]; then hosts+=("$tailnet_name"); fi
      fi ;;
    *) hosts+=("$KBBL_BIND_HOST") ;;
  esac
  for host in "${hosts[@]}"; do
    if [[ "$host" == *:* && "$host" != \[*\] ]]; then host="[$host]"; fi
    origins+=("http://$host:$KBBL_INTERNAL_PORT")
  done
  (IFS=,; echo "${origins[*]}")
}
if [ -z "${OAKRIDGE_ALLOWED_ORIGINS:-}" ]; then OAKRIDGE_ALLOWED_ORIGINS="$(default_allowed_origins)"; fi
export OAKRIDGE_ALLOWED_ORIGINS

start_managed_postgres() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "oakridge: Docker is required when DBOS_SYSTEM_DATABASE_URL is not set" >&2
    echo "oakridge: start Docker, or export DBOS_SYSTEM_DATABASE_URL for an existing PostgreSQL database" >&2
    exit 1
  fi
  if ! docker info >/dev/null 2>&1; then
    echo "oakridge: Docker is installed but its daemon is not running" >&2
    echo "oakridge: start Docker, or export DBOS_SYSTEM_DATABASE_URL for an existing PostgreSQL database" >&2
    exit 1
  fi

  if docker container inspect "$POSTGRES_CONTAINER" >/dev/null 2>&1; then
    if [ "$(docker inspect -f '{{.State.Running}}' "$POSTGRES_CONTAINER")" != "true" ]; then
      echo "oakridge: starting PostgreSQL container $POSTGRES_CONTAINER"
      docker start "$POSTGRES_CONTAINER" >/dev/null
    fi
  else
    echo "oakridge: creating PostgreSQL container $POSTGRES_CONTAINER on 127.0.0.1:$POSTGRES_PORT"
    docker run --detach \
      --name "$POSTGRES_CONTAINER" \
      --restart unless-stopped \
      --publish "127.0.0.1:${POSTGRES_PORT}:5432" \
      --env POSTGRES_USER=oakridge \
      --env POSTGRES_PASSWORD=oakridge \
      --env POSTGRES_DB=oakridge \
      --volume "${POSTGRES_VOLUME}:/var/lib/postgresql/data" \
      "$POSTGRES_IMAGE" >/dev/null
  fi

  echo "oakridge: waiting for PostgreSQL"
  for _attempt in $(seq 1 30); do
    if docker exec "$POSTGRES_CONTAINER" pg_isready --username oakridge --dbname oakridge >/dev/null 2>&1; then return; fi
    sleep 1
  done
  echo "oakridge: PostgreSQL did not become ready; inspect with: docker logs $POSTGRES_CONTAINER" >&2
  exit 1
}

if [ -z "${DBOS_SYSTEM_DATABASE_URL:-}" ]; then
  start_managed_postgres
  DBOS_SYSTEM_DATABASE_URL="postgres://oakridge:oakridge@127.0.0.1:${POSTGRES_PORT}/oakridge"
fi
# DBOS_APPLICATION_VERSION is the engine digest unless the operator pins it; a git SHA
# here would park every in-flight run on each deploy, whatever changed.
if [ -n "${DBOS_APPLICATION_VERSION:-}" ]; then export DBOS_APPLICATION_VERSION; fi
if [ -n "${OAKRIDGE_GITHUB_TOKEN:-}" ]; then export OAKRIDGE_GITHUB_TOKEN; fi

dbos_pid=""
kbbl_pid=""
observation_pid=""
stop_services() {
  trap - INT TERM EXIT
  if [ -n "$kbbl_pid" ] && kill -0 "$kbbl_pid" 2>/dev/null; then kill -TERM "$kbbl_pid" 2>/dev/null || true; fi
  if [ -n "$dbos_pid" ] && kill -0 "$dbos_pid" 2>/dev/null; then kill -TERM "$dbos_pid" 2>/dev/null || true; fi
  if [ -n "$observation_pid" ] && kill -0 "$observation_pid" 2>/dev/null; then kill -TERM "$observation_pid" 2>/dev/null || true; fi
  [ -z "$kbbl_pid" ] || wait "$kbbl_pid" 2>/dev/null || true
  [ -z "$dbos_pid" ] || wait "$dbos_pid" 2>/dev/null || true
  [ -z "$observation_pid" ] || wait "$observation_pid" 2>/dev/null || true
}
stop_from_signal() {
  stop_services
  exit 0
}
trap stop_from_signal INT TERM
trap stop_services EXIT

if [ -n "${OBSERVATION_DATABASE_URL:-}" ]; then
  echo "oakridge: starting observation service"
  (
    cd "$OAKRIDGE_ROOT/observation"
    bun run start
  ) &
  observation_pid=$!
fi

echo "oakridge: starting DBOS backend at $DBOS_URL"
(
  cd "$DBOS_ROOT"
  DBOS_SYSTEM_DATABASE_URL="$DBOS_SYSTEM_DATABASE_URL" \
    OAKRIDGE_PROMPT_ROOT="${OAKRIDGE_PROMPT_ROOT:-$OAKRIDGE_ROOT}" \
    KBBL_BASE_URL="${KBBL_BASE_URL:-$KBBL_URL}" \
    OAKRIDGE_DBOS_HOST="$DBOS_HOST" \
    OAKRIDGE_CORE_WASM="$CORE_WASM" \
    OAKRIDGE_GATED_REVIEW_URL="$GATED_REVIEW_URL" \
    OAKRIDGE_PUBLICATION_KEY="$OAKRIDGE_PUBLICATION_KEY" \
    OAKRIDGE_AGENT_WORKDIR="$AGENT_WORKDIR" \
    PORT="$DBOS_PORT" \
    bun run start
) &
dbos_pid=$!

echo "oakridge: starting kbbl (the PWA rebuild may take a moment)"
env -u ANTHROPIC_API_KEY \
  OAKRIDGE_CORE_BASE_URL="$DBOS_URL" \
  OAKRIDGE_GATED_REVIEW_URL="$GATED_REVIEW_URL" \
  "$OAKRIDGE_ROOT/kbbl/scripts/kbbl-start" "$@" &
kbbl_pid=$!

echo "oakridge: open http://${KBBL_DISPLAY_HOST}:${KBBL_DISPLAY_PORT}/#oakridge"
echo "oakridge: browser writes allowed from $OAKRIDGE_ALLOWED_ORIGINS"
if [ -n "$observation_pid" ]; then
  echo "oakridge: Ctrl-C stops kbbl, DBOS and observation; the PostgreSQL container remains running"
else
  echo "oakridge: Ctrl-C stops kbbl and DBOS; the PostgreSQL container remains running"
fi

set +e
wait_pids=("$dbos_pid" "$kbbl_pid")
if [ -n "$observation_pid" ]; then wait_pids+=("$observation_pid"); fi
wait -n "${wait_pids[@]}"
exit_code=$?
set -e
exit "$exit_code"
