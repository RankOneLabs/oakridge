{
  "name": "oakridge-dbos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "ops": "bun run src/ops.ts",
    "test": "bun run test:unit",
    "test:unit": "bash tests/run-suite.sh unit",
    "test:integration": "bash tests/run-suite.sh integration",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "generate:records": "bun scripts/generate-storage-records.ts",
    "storage:adopt": "bun src/storage/migrate.ts --adopt",
    "cutover:preflight": "bun scripts/cutover-preflight.ts",
    "storage:check": "bun scripts/generate-storage-records.ts --check"
  },
  "dependencies": {
    "@dbos-inc/dbos-sdk": "4.25.14",
    "hono": "^4.6.14",
    "kysely": "~0.29.6",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@types/bun": "^1.3.13",
    "@types/pg": "^8.15.5",
    "kysely-codegen": "~0.20.0",
    "typescript": "^5.7.2"
  }
}
