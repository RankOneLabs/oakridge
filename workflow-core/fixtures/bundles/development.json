{
  "workflow": "development",
  "input": {
    "title": "text",
    "spec": "text",
    "repositories": "list(repository)",
    "admission": "boolean",
    "final_merge_policy": "final_merge_policy"
  },
  "schemas": {
    "final_merge_policy": "enum(require_merge, allow_close_without_merge)",
    "repository": {
      "key": "ident",
      "preparation": {
        "repository_path": "repo_path",
        "expected_head": "optional(text)"
      },
      "forge": "forge"
    },
    "forge": {
      "owner": "ident",
      "name": "ident",
      "build_base": "text",
      "final_base": "text"
    },
    "workspace": {
      "repository_path": "repo_path",
      "push_remote_owner": "ident",
      "head": "ident"
    },
    "prepared": {
      "key": "ident",
      "workspace": "workspace"
    },
    "pr_observations": {
      "observations": "list({provider: text, owner: ident, name: ident, number: integer, url: text, head_branch: text, base_branch: text, head_sha: optional(text), state: text, source: text, observed_at: text, merged_at: optional(text)})"
    },
    "completed_cohort": {
      "cohort_id": "ident",
      "repository_key": "ident",
      "title": "text",
      "pr_url": "text",
      "branch": "text",
      "build_result": "build_body"
    },
    "severity": "enum(blocking, warning, info)",
    "risk": {
      "description": "text",
      "mitigation": "text"
    },
    "issue": {
      "description": "text",
      "severity": "severity"
    },
    "analysis_body": {
      "summary": "text",
      "source_spec_refs": "list(text)",
      "findings": "list(spec_finding)",
      "requirements": "list(requirement)",
      "risks": "list(risk)"
    },
    "spec_finding": {
      "id": "ident",
      "description": "text",
      "severity": "severity"
    },
    "requirement": {
      "id": "ident",
      "description": "text",
      "status": "requirement_status"
    },
    "requirement_status": "enum(implementable, blocked, ambiguous)",
    "plan_body": {
      "summary": "text",
      "cohorts": "list(plan_cohort)",
      "dependency_order": "list(ident)",
      "scope": {
        "in_scope": "list(text)",
        "out_of_scope": "list(text)"
      },
      "acceptance_criteria": "list(text)",
      "risks": "list(risk)"
    },
    "plan_cohort": {
      "id": "ident",
      "repository_key": "optional(ident)",
      "title": "text",
      "scope": "text",
      "depends_on": "list(ident)",
      "description": "optional(text)",
      "files_in_scope": "list(text)",
      "decisions": "list(text)",
      "acceptance_criteria": "list(text)"
    },
    "brief_body": {
      "cohort_id": "ident",
      "repository_key": "ident",
      "title": "text",
      "depends_on": "list(ident)",
      "goal": "text",
      "files_in_scope": "list(text)",
      "decisions_made": "list(brief_decision)",
      "approaches_rejected": "list(rejected_approach)",
      "acceptance_criteria": "list(text)",
      "next_action": "text"
    },
    "brief_decision": {
      "decision": "text",
      "rationale": "text"
    },
    "rejected_approach": {
      "approach": "text",
      "reason": "text"
    },
    "build_body": {
      "repository_key": "optional(ident)",
      "summary": "text",
      "changed_files": "list(text)",
      "tests": "test_evidence",
      "delegated_session_metadata": "optional(build_metadata)",
      "known_issues": "list(issue)"
    },
    "test_evidence": {
      "passed": "integer",
      "failed": "integer",
      "output": "optional(text)",
      "summary": "optional(text)",
      "cargo_test_output": "optional(text)"
    },
    "build_metadata": {
      "cohort_id": "optional(ident)",
      "session_id": "optional(ident)",
      "branch": "optional(ident)"
    },
    "assessment_body": {
      "verdict": "enum(pass, pass_with_notes, fail)",
      "findings": "list(assessment_finding)",
      "test_evidence": "optional(test_evidence)",
      "recommended_next_actions": "list(text)"
    },
    "assessment_finding": {
      "criterion": "optional(text)",
      "status": "optional(enum(met, not_met, partial))",
      "evidence": "optional(text)",
      "description": "optional(text)"
    },
    "pr_body": {
      "pr_url": "text",
      "branch": "text",
      "summary": "text",
      "review_status": "optional(enum(draft, ready, changes_requested, approved, merged, closed))"
    }
  },
  "run": {
    "units": {
      "prepare": {
        "input": {
          "repositories": "input.repositories"
        },
        "group": {
          "units": {
            "repository": {
              "for_each": "input.repositories",
              "key": "each.key",
              "stage": "prepare",
              "input": {
                "repository": "each"
              }
            }
          },
          "outcome": {
            "workspaces": "map(repository, repository.outcome)"
          }
        }
      },
      "analysis": {
        "stage": "analysis",
        "after": [
          "prepare"
        ],
        "input": {
          "spec": "input.spec",
          "repositories": "input.repositories",
          "workspaces": "prepare.outcome.workspaces"
        }
      },
      "planning": {
        "stage": "planning",
        "after": [
          "prepare",
          "analysis"
        ],
        "input": {
          "spec": "input.spec",
          "repositories": "input.repositories",
          "workspaces": "prepare.outcome.workspaces",
          "analysis": "analysis.outcome.analysis"
        }
      },
      "briefs": {
        "after": [
          "prepare",
          "analysis",
          "planning"
        ],
        "input": {
          "spec": "input.spec",
          "workspaces": "prepare.outcome.workspaces",
          "analysis": "analysis.outcome.analysis",
          "plan": "planning.outcome.plan"
        },
        "group": {
          "pools": {
            "writers": 4
          },
          "units": {
            "brief": {
              "for_each": "input.plan.cohorts",
              "key": "each.id",
              "stage": "brief",
              "pool": "writers",
              "input": {
                "cohort": "each",
                "plan": "input.plan",
                "analysis": "input.analysis",
                "spec": "input.spec",
                "workspaces": "input.workspaces"
              }
            }
          },
          "outcome": {
            "briefs": "map(brief, brief.outcome.brief)"
          }
        }
      },
      "implementation": {
        "after": [
          "prepare",
          "briefs"
        ],
        "input": {
          "briefs": "briefs.outcome.briefs",
          "repositories": "input.repositories",
          "workspaces": "prepare.outcome.workspaces",
          "admission": "input.admission"
        },
        "group": {
          "pools": {
            "builders": 4
          },
          "units": {
            "cohort": {
              "for_each": "input.briefs",
              "key": "each.cohort_id",
              "after": "each.depends_on",
              "stage": "cohort",
              "pool": "builders",
              "input": {
                "brief": "each",
                "repository": "lookup(input.repositories, key, each.repository_key)",
                "workspace": "lookup(input.workspaces, key, each.repository_key).workspace",
                "admission": "input.admission"
              }
            }
          },
          "outcome": {
            "cohorts": "map(cohort, cohort.outcome)"
          }
        }
      },
      "integration": {
        "after": [
          "prepare",
          "implementation"
        ],
        "input": {
          "repositories": "input.repositories",
          "workspaces": "prepare.outcome.workspaces",
          "cohorts": "implementation.outcome.cohorts",
          "final_merge_policy": "input.final_merge_policy"
        },
        "group": {
          "units": {
            "repository": {
              "for_each": "filter(input.repositories, contains(map(input.cohorts, item.repository_key), item.key))",
              "key": "each.key",
              "stage": "integration",
              "input": {
                "repository": "each",
                "workspace": "lookup(input.workspaces, key, each.key).workspace",
                "cohorts": "filter(input.cohorts, item.repository_key == each.key)",
                "final_merge_policy": "input.final_merge_policy"
              }
            }
          },
          "outcome": {
            "integrations": "map(repository, repository.outcome)"
          }
        }
      }
    },
    "outcome": {
      "cohorts": "implementation.outcome.cohorts",
      "integrations": "integration.outcome.integrations"
    }
  },
  "stages": {
    "prepare": {
      "input": {
        "repository": "repository"
      },
      "artifacts": {
        "workspace": {
          "schema": "workspace"
        }
      },
      "workers": {
        "git": {
          "kind": "code",
          "operation": "repository.prepare",
          "inputs": {
            "repository_path": "input.repository.preparation.repository_path",
            "expected_head": "input.repository.preparation.expected_head"
          },
          "creates": [
            "workspace"
          ]
        }
      },
      "done_when": "published(workspace)",
      "outcome": {
        "key": "input.repository.key",
        "workspace": "latest(workspace)"
      }
    },
    "analysis": {
      "input": {
        "spec": "text",
        "repositories": "list(repository)",
        "workspaces": "list(prepared)"
      },
      "artifacts": {
        "analysis": {
          "schema": "analysis_body"
        }
      },
      "workers": {
        "author": {
          "kind": "agent",
          "prompts": {
            "initial": "development/analysis.md",
            "revise": "development/analysis-revise.md"
          },
          "inputs": {
            "spec": "input.spec",
            "repositories": "input.repositories",
            "workspaces": "input.workspaces"
          },
          "creates": [
            "analysis"
          ]
        }
      },
      "reviews": {
        "analysis_review": {
          "of": "analysis",
          "by": "operator",
          "prompt": "development/analysis-review.md",
          "inputs": {
            "spec": "input.spec",
            "analysis": "latest(analysis)"
          },
          "decisions": {
            "accept": {
              "effect": "approve",
              "label": "Accept"
            },
            "request_changes": {
              "effect": "request_changes",
              "label": "Request changes",
              "fields": {
                "feedback": "What must the analysis change?"
              }
            }
          }
        }
      },
      "done_when": "approved(analysis)",
      "outcome": {
        "analysis": "latest(analysis)"
      }
    },
    "planning": {
      "input": {
        "spec": "text",
        "repositories": "list(repository)",
        "workspaces": "list(prepared)",
        "analysis": "analysis_body"
      },
      "artifacts": {
        "plan": {
          "schema": "plan_body",
          "validate": [
            {
              "check": "len(plan.cohorts) > 0",
              "message": "The plan must name at least one cohort."
            },
            {
              "check": "every(plan.cohorts, contains(map(input.repositories, item.key), item.repository_key))",
              "message": "Every cohort's repository_key must be the key of one of the run's repositories."
            },
            {
              "check": "valid_graph(plan.cohorts, id, depends_on)",
              "message": "Cohort ids must be unique idents, and each depends_on must name other cohorts without repeats or a cycle."
            }
          ]
        }
      },
      "workers": {
        "planner": {
          "kind": "agent",
          "prompts": {
            "initial": "development/plan.md",
            "revise": "development/plan-revise.md"
          },
          "inputs": {
            "spec": "input.spec",
            "repositories": "input.repositories",
            "workspaces": "input.workspaces",
            "analysis": "input.analysis"
          },
          "creates": [
            "plan"
          ]
        }
      },
      "reviews": {
        "plan_review": {
          "of": "plan",
          "by": "operator",
          "prompt": "development/plan-review.md",
          "inputs": {
            "analysis": "input.analysis",
            "plan": "latest(plan)"
          },
          "decisions": {
            "accept": {
              "effect": "approve",
              "label": "Accept"
            },
            "request_changes": {
              "effect": "request_changes",
              "label": "Request changes",
              "fields": {
                "feedback": "What must the plan change?"
              }
            }
          }
        }
      },
      "done_when": "approved(plan)",
      "outcome": {
        "plan": "latest(plan)"
      }
    },
    "brief": {
      "input": {
        "cohort": "plan_cohort",
        "plan": "plan_body",
        "analysis": "analysis_body",
        "spec": "text",
        "workspaces": "list(prepared)"
      },
      "artifacts": {
        "brief": {
          "schema": "brief_body",
          "validate": [
            {
              "check": "brief.cohort_id == input.cohort.id",
              "message": "The brief's cohort_id must be its plan cohort's id."
            },
            {
              "check": "brief.repository_key == input.cohort.repository_key",
              "message": "The brief's repository_key must be its plan cohort's."
            },
            {
              "check": "brief.depends_on == input.cohort.depends_on",
              "message": "The brief's depends_on must be its plan cohort's, in the same order."
            }
          ]
        }
      },
      "workers": {
        "writer": {
          "kind": "agent",
          "prompts": {
            "initial": "development/brief.md",
            "revise": "development/brief-revise.md"
          },
          "inputs": {
            "cohort": "input.cohort",
            "plan": "input.plan",
            "analysis": "input.analysis",
            "spec": "input.spec",
            "workspaces": "input.workspaces"
          },
          "creates": [
            "brief"
          ]
        }
      },
      "reviews": {
        "brief_review": {
          "of": "brief",
          "by": "operator",
          "prompt": "development/brief-review.md",
          "inputs": {
            "cohort": "input.cohort",
            "brief": "latest(brief)"
          },
          "decisions": {
            "accept": {
              "effect": "approve",
              "label": "Accept"
            },
            "request_changes": {
              "effect": "request_changes",
              "label": "Request changes",
              "fields": {
                "feedback": "What must the brief change?"
              }
            }
          }
        }
      },
      "done_when": "approved(brief)",
      "outcome": {
        "brief": "latest(brief)"
      }
    },
    "cohort": {
      "input": {
        "brief": "brief_body",
        "repository": "repository",
        "workspace": "workspace",
        "admission": "boolean"
      },
      "artifacts": {
        "brief": {
          "schema": "brief_body"
        },
        "build_result": {
          "schema": "build_body"
        },
        "pr": {
          "schema": "pr_body"
        },
        "assessment": {
          "schema": "assessment_body"
        },
        "pr_state": {
          "schema": "pr_observations"
        }
      },
      "workers": {
        "publish_brief": {
          "kind": "code",
          "operation": "value.publish",
          "inputs": {
            "value": "input.brief"
          },
          "creates": [
            "brief"
          ]
        },
        "builder": {
          "kind": "agent",
          "when": "approved(brief) or not input.admission",
          "prompts": {
            "initial": "development/build.md",
            "revise": "development/build-revise.md"
          },
          "inputs": {
            "brief": "input.brief",
            "repository": "input.repository"
          },
          "workspace": "repository(input.workspace)",
          "creates": [
            "build_result",
            "pr"
          ]
        },
        "assessor": {
          "kind": "agent",
          "prompts": {
            "review": "development/assess.md"
          },
          "inputs": {
            "brief": "input.brief",
            "pr": "latest(pr)"
          },
          "workspace": "repository(input.workspace)",
          "reviews": "build_result",
          "creates": [
            "assessment"
          ]
        },
        "pr_watch": {
          "kind": "code",
          "operation": "pull_request.observe",
          "when": "published(pr)",
          "inputs": {
            "query": "{owner: input.repository.forge.owner, name: input.repository.forge.name, head_owner: input.workspace.push_remote_owner, head_branch: latest(pr).branch, base_branch: input.repository.forge.build_base}"
          },
          "every": "2m",
          "creates": [
            "pr_state"
          ]
        }
      },
      "reviews": {
        "admission": {
          "of": "brief",
          "by": "operator",
          "when": "input.admission",
          "prompt": "development/admission.md",
          "inputs": {
            "brief": "latest(brief)"
          },
          "decisions": {
            "admit": {
              "effect": "approve",
              "label": "Admit"
            }
          }
        },
        "assessment_review": {
          "of": "assessment",
          "by": "operator",
          "prompt": "development/assessment-review.md",
          "inputs": {
            "brief": "input.brief",
            "build_result": "latest(build_result)",
            "pr": "latest(pr)",
            "assessment": "latest(assessment)"
          },
          "decisions": {
            "accept": {
              "effect": "approve",
              "label": "Accept"
            },
            "request_build_changes": {
              "effect": "request_changes",
              "on": "build_result",
              "label": "Request build changes",
              "fields": {
                "feedback": "What must the builder change?"
              }
            }
          }
        },
        "pr_closed": {
          "of": "build_result",
          "by": "engine",
          "when": "published(pr) and published(pr_state) and lookup(latest(pr_state).observations, url, latest(pr).pr_url).state == \"closed_unmerged\"",
          "decisions": {
            "replace_pr": {
              "effect": "request_changes",
              "label": "Replace the closed PR",
              "feedback": "The pull request was closed without being merged. Open a new pull request for this build and publish the build result and the PR summary again."
            }
          }
        }
      },
      "done_when": "approved(assessment) and published(build_result) and published(pr) and published(pr_state) and lookup(latest(pr_state).observations, url, latest(pr).pr_url).state == \"merged\"",
      "outcome": {
        "cohort_id": "input.brief.cohort_id",
        "repository_key": "input.brief.repository_key",
        "title": "input.brief.title",
        "pr_url": "latest(pr).pr_url",
        "branch": "latest(pr).branch",
        "build_result": "latest(build_result)"
      }
    },
    "integration": {
      "input": {
        "repository": "repository",
        "workspace": "workspace",
        "cohorts": "list(completed_cohort)",
        "final_merge_policy": "final_merge_policy"
      },
      "artifacts": {
        "pr": {
          "schema": "pr_body"
        },
        "pr_state": {
          "schema": "pr_observations"
        }
      },
      "workers": {
        "integrator": {
          "kind": "agent",
          "prompts": {
            "initial": "development/integrate.md",
            "revise": "development/integrate-revise.md"
          },
          "inputs": {
            "repository": "input.repository",
            "cohorts": "input.cohorts"
          },
          "workspace": "repository(input.workspace)",
          "creates": [
            "pr"
          ]
        },
        "pr_watch": {
          "kind": "code",
          "operation": "pull_request.observe",
          "when": "published(pr)",
          "inputs": {
            "query": "{owner: input.repository.forge.owner, name: input.repository.forge.name, head_owner: input.workspace.push_remote_owner, head_branch: latest(pr).branch, base_branch: input.repository.forge.final_base}"
          },
          "every": "2m",
          "creates": [
            "pr_state"
          ]
        }
      },
      "reviews": {
        "integration_review": {
          "of": "pr",
          "by": "operator",
          "prompt": "development/integration-review.md",
          "inputs": {
            "repository": "input.repository",
            "cohorts": "input.cohorts",
            "pr": "latest(pr)",
            "pr_state": "latest(pr_state)"
          },
          "decisions": {
            "accept": {
              "effect": "approve",
              "label": "Accept"
            },
            "request_changes": {
              "effect": "request_changes",
              "label": "Request changes",
              "fields": {
                "feedback": "What must the integration change?"
              }
            }
          }
        },
        "pr_closed": {
          "of": "pr",
          "by": "engine",
          "when": "input.final_merge_policy == \"require_merge\" and published(pr) and published(pr_state) and lookup(latest(pr_state).observations, url, latest(pr).pr_url).state == \"closed_unmerged\"",
          "decisions": {
            "replace_pr": {
              "effect": "request_changes",
              "label": "Replace the closed PR",
              "feedback": "The integration pull request was closed without being merged, and this run requires a merge. Open a new pull request and publish the PR summary again."
            }
          }
        }
      },
      "done_when": "approved(pr) and published(pr_state) and (lookup(latest(pr_state).observations, url, latest(pr).pr_url).state == \"merged\" or (input.final_merge_policy == \"allow_close_without_merge\" and lookup(latest(pr_state).observations, url, latest(pr).pr_url).state == \"closed_unmerged\"))",
      "outcome": {
        "repository_key": "input.repository.key",
        "pr_url": "latest(pr).pr_url",
        "is_merged": "lookup(latest(pr_state).observations, url, latest(pr).pr_url).state == \"merged\""
      }
    }
  }
}
