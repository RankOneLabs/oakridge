#!/usr/bin/env bash
set -euo pipefail

WORKDIR=""
if [ $# -gt 0 ] && [[ "$1" != --* ]]; then
  WORKDIR="$1"
  shift
fi

if [ "$WORKDIR" != "" ]; then
  if [ ! -d "$WORKDIR" ]; then
    echo "kbbl-start: workdir not found: $WORKDIR" >&2
    exit 1
  fi
  WORKDIR_ABS="$(cd "$WORKDIR" && pwd)"
fi

KBBL_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Rebuild the PWA bundle so a fresh `git pull` doesn't silently serve a
# stale pwa/dist. Vite is fast (~1s) and the dist is required to serve
# anything useful, so eat the cost unconditionally.
(cd "$KBBL_ROOT" && bun run build:pwa)

# Bun loads .env from the cwd, which here is wherever the launcher was run from.
# An isolated stack sets KBBL_NO_ENV_FILE so that file cannot add to its environment.
BUN_RUN=(bun run)
if [ "${KBBL_NO_ENV_FILE:-}" = "1" ]; then BUN_RUN=(bun --no-env-file run); fi

if [ "$WORKDIR" != "" ]; then
  exec "${BUN_RUN[@]}" "$KBBL_ROOT/core/server.ts" --workdir="$WORKDIR_ABS" "$@"
fi

exec "${BUN_RUN[@]}" "$KBBL_ROOT/core/server.ts" "$@"
