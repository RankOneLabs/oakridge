{
  "question": "When a change needs a value added or renamed in several places, which kinds of place do models miss?",
  "hypotheses": [
    {
      "id": "h_shape_vs_control",
      "statement": "Shapes other than type_enforced are missed more often than the type-enforced control in the same task type."
    },
    {
      "id": "h_import_path",
      "statement": "sibling_only and outside_code are missed more often than reference (direct import), so losing the import path matters."
    },
    {
      "id": "h_rename_vs_add",
      "statement": "Rename tasks are missed more often than add tasks for name_only, sibling_only and outside_code."
    }
  ],
