  "outcomes": [
    {
      "id": "scored",
      "rule": "Graded; the manipulated fact and the anchor are each held or missed, read from hidden test groups titled fact:<fact id>:."
    },
    {
      "id": "unscored",
      "rule": "Graded, but a fact's tests did not run (patch failed to apply or type-check); the reason is recorded."
    },
    {
      "id": "stopped",
      "rule": "Ended by a limit before submitting (requests, output tokens, wall time or request timeout)."
    }
  ],
  "decision_rule": [
    {
      "condition": "Any model and version has fewer than 5 dispatched attempts",
      "next_step": "Incomplete; review the plan's halt first."
    },
    {
      "condition": "No model is readable (at least 10 scored attempts in each shape and task type), or every readable model is excluded",
      "next_step": "Stop and review."
    },
    {
      "condition": "Every readable model misses nothing outside the control",
      "next_step": "Stop; report a ceiling."
    },
    {
      "condition": "Otherwise",
      "next_step": "Read the results per shape against the control; write a shape result only when at least 2 readable models miss on the same shape."
    }
  ],
