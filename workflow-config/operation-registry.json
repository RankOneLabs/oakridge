[
  {
    "key": "repository.prepare",
    "input_schema": {
      "repository_path": "repo_path",
      "expected_head": "optional(text)",
      "base_branch": "text",
      "integration_branch": "text"
    },
    "output_schema": {
      "repository_path": "repo_path",
      "push_remote_owner": "ident",
      "head": "ident",
      "base_branch": "text"
    },
    "error_codes": [
      "worktree_unrecoverable",
      "head_changed",
      "provider_rejected"
    ]
  },
  {
    "key": "value.publish",
    "input_schema": {
      "value": "$value"
    },
    "output_schema": "$value",
    "error_codes": []
  },
  {
    "key": "pull_request.inspect",
    "input_schema": {
      "query": {
        "owner": "ident",
        "name": "ident",
        "head_owner": "ident",
        "head_branch": "text",
        "base_branch": "text",
        "pr_url": "text"
      }
    },
    "output_schema": {
      "status": "enum(open, merged, closed_unmerged)",
      "pr_sequence": "integer",
      "observed_link": "text",
      "head_sha": "optional(text)",
      "merged_at": "optional(text)"
    },
    "error_codes": [
      "discovery_unsupported",
      "auth",
      "provider_rejected",
      "pull_request_mismatch"
    ]
  }
]
