[
  {
    "key": "repository.prepare",
    "version": 1,
    "input_schema": {
      "repository_path": "repo_path",
      "expected_head": "optional(text)"
    },
    "output_schema": {
      "repository_path": "repo_path",
      "push_remote_owner": "ident",
      "head": "ident"
    },
    "error_codes": [
      "worktree_unrecoverable",
      "head_changed"
    ]
  },
  {
    "key": "pull_request.observe",
    "version": 1,
    "input_schema": {
      "query": {
        "owner": "ident",
        "name": "ident",
        "head_owner": "ident",
        "head_branch": "text",
        "base_branch": "text"
      }
    },
    "output_schema": {
      "observations": "list({provider: text, owner: ident, name: ident, number: integer, url: text, head_branch: text, base_branch: text, head_sha: optional(text), state: text, source: text, merged_at: optional(text)})"
    },
    "error_codes": [
      "discovery_unsupported",
      "auth",
      "provider_rejected"
    ]
  },
  {
    "key": "value.publish",
    "version": 1,
    "input_schema": {
      "value": "$value"
    },
    "output_schema": "$value",
    "error_codes": []
  }
]
