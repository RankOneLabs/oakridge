                }
              ],
              "outcome": null
            }
          },
          {
            "variant": "amend",
            "node": {
              "kind": "if",
              "id": "amend_guard",
              "condition": {
                "kind": "all",
                "items": [
                  {
                    "kind": "equals",
                    "left": {
                      "kind": "reference",
                      "root": {
                        "kind": "trigger"
                      },
                      "path": [
                        "assay_log"
                      ]
                    },
                    "right": {
                      "kind": "reference",
                      "root": {
                        "kind": "output",
                        "key": "assay_log"
                      },
                      "path": []
                    }
                  },
                  {
                    "kind": "equals",
                    "left": {
                      "kind": "reference",
                      "root": {
                        "kind": "trigger"
                      },
                      "path": [
                        "current_label"
                      ]
                    },
                    "right": {
                      "kind": "reference",
                      "root": {
                        "kind": "output",
                        "key": "current_label"
                      },
                      "path": []
                    }
                  }
                ]
              },
              "then": {
                "kind": "apply",
                "id": "revised_publication",
                "mutations": [
                  {
                    "kind": "set_state",
                    "value": {
                      "kind": "literal",
                      "schema": "phase",
                      "value": {
                        "kind": "inspection",
                        "value": {}
                      }
                    }
                  }
                ],
                "actions": [
                  {
                    "worker": "potter",
                    "action": "shape"
                  }
                ],
                "outcome": null
              },
              "otherwise": {
                "kind": "reject",
                "id": "amend_denied",
                "error": "invalid_kiln_command",
                "detail": "publication predecessor is stale"
              }
            }
          },
          {
            "variant": "quench",
            "node": {
              "kind": "apply",
              "id": "stop_publication",
              "mutations": [],
              "actions": [],
              "outcome": {
                "kind": "literal",
                "schema": "result",
                "value": {
                  "kind": "withdrawn",
                  "value": {}
                }
              }
            }
          },
          {
            "variant": "finish",
            "node": {
              "kind": "apply",
              "id": "finish_publication",
              "mutations": [],
              "actions": [],
              "outcome": {
                "kind": "literal",
                "schema": "result",
                "value": {
                  "kind": "released",
                  "value": {}
                }
              }
            }
          },
          {
            "variant": "submitted",
            "node": {
              "kind": "apply",
              "id": "record_publication",
              "mutations": [],
              "actions": [],
              "outcome": null
            }
          }
