      "tree": {
        "kind": "match",
        "id": "kiln_dispatch",
        "value": {
          "kind": "reference",
          "root": {
            "kind": "trigger"
          },
          "path": []
        },
        "cases": [
          {
            "variant": "light",
            "node": {
              "kind": "apply",
              "id": "initial_publication",
              "mutations": [
                {
                  "kind": "set_state",
                  "value": {
                    "kind": "literal",
                    "schema": "phase",
                    "value": {
                      "kind": "inspection",
                      "value": {}
                    }
                  }
                }
              ],
              "actions": [
                {
                  "worker": "potter",
